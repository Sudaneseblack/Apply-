name: Build APK

on:
  push:
    branches:
      - main
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build-apk:
    name: Build Wad Faisal APK
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: npm

      - name: Setup Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '21'

      - name: Check project
        run: |
          echo "Checking files..."
          test -f index.html
          test -f script.js
          test -f style.css
          echo "Project files OK"

      - name: Create web folder
        run: |
          rm -rf www
          mkdir -p www
          cp index.html www/index.html
          cp script.js www/script.js
          cp style.css www/style.css

      - name: Create package.json
        run: |
          cat > package.json <<'EOF'
          {
            "name": "wad-faisal",
            "version": "1.0.0",
            "private": true
          }
          EOF

      - name: Install Capacitor
        run: |
          npm install @capacitor/core@8 @capacitor/cli@8 @capacitor/android@8

      - name: Initialize Capacitor
        run: |
          npx cap init "ود فيصل" "com.sudaneseblack.wadfaisal" --web-dir=www

      - name: Add Android
        run: |
          npx cap add android

      - name: Sync Android
        run: |
          npx cap sync android

      - name: Build Debug APK
        working-directory: android
        run: |
          chmod +x gradlew
          ./gradlew assembleDebug --stacktrace

      - name: Verify APK
        run: |
          test -f android/app/build/outputs/apk/debug/app-debug.apk
          ls -lh android/app/build/outputs/apk/debug/app-debug.apk

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: Wad-Faisal-APK
          path: android/app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error
