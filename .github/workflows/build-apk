name: Build APK

on:
  push:
    branches:
      - main
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: تحميل المشروع
        uses: actions/checkout@v4

      - name: إعداد Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: إعداد Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '21'

      - name: التأكد من ملفات المشروع
        run: |
          test -f index.html
          test -f script.js
          test -f style.css
          echo "تم العثور على ملفات المشروع"

      - name: تجهيز ملفات الموقع
        run: |
          rm -rf www
          mkdir www
          cp index.html www/index.html
          cp script.js www/script.js
          cp style.css www/style.css

      - name: إنشاء package.json
        run: |
          cat > package.json <<'EOF'
          {
            "name": "apply",
            "version": "1.0.0",
            "private": true
          }
          EOF

      - name: تثبيت Capacitor
        run: |
          npm install @capacitor/core@7 @capacitor/cli@7 @capacitor/android@7

      - name: إنشاء إعداد Android
        run: |
          npx cap init "Apply" "com.sudaneseblack.apply" --web-dir=www

      - name: إضافة Android
        run: |
          npx cap add android

      - name: مزامنة التطبيق
        run: |
          npx cap sync android

      - name: بناء APK
        working-directory: android
        run: |
          chmod +x gradlew
          ./gradlew assembleDebug

      - name: التأكد من APK
        run: |
          ls -lh android/app/build/outputs/apk/debug/app-debug.apk

      - name: رفع APK
        uses: actions/upload-artifact@v4
        with:
          name: Apply-APK
          path: android/app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error
